   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 12.96263038548753,
   "text": "Play with me."
  },
  {
   "who": "therapist",
   "start": 22.731861154718302,
   "end": 24.536713762428054,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 24.936713762428052,
   "end": 27.234990406418984,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 44.20422117564975,
   "end": 46.046942264085125,
   "text": "Now let's slow down."
  },
  {
   "who": "therapist",
   "start": 60.046942264085104,
   "end": 63.1615907901622,
   "text": "Let's play together. Ready, go."
  },
  {
   "who": "therapist",
   "start": 73.39236002093142,
   "end": 75.07825571254139,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 83.46287109715678,
   "end": 85.26772370486653,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 85.66772370486653,
   "end": 87.96600034885746,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 100.94292342578053,
   "end": 102.02446537589391,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 102.42446537589392,
   "end": 104.74201639630208,
   "text": "That's the end. Thank you!"
  }

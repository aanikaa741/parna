 "speech": [
  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 13.449931972789118,
   "text": "Keep the beat with me."
  },
  {
   "who": "therapist",
   "start": 29.783265306122452,
   "end": 30.693469387755105,
   "text": "Nice!"
  },
  {
   "who": "therapist",
   "start": 31.093469387755103,
   "end": 33.39174603174603,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 56.92507936507936,
   "end": 58.70467120181406,
   "text": "Now let's go faster."
  },
  {
   "who": "therapist",
   "start": 73.78159427873712,
   "end": 74.93456480027906,
   "text": "Great job."
  },
  {
   "who": "therapist",
   "start": 75.33456480027907,
   "end": 78.44921332635616,
   "text": "Let's play together. Ready, go."
  },
  {
   "who": "therapist",
   "start": 92.78254665968949,
   "end": 93.93551718123143,
   "text": "Great job."
  },
  {
   "who": "therapist",
   "start": 94.33551718123144,
   "end": 96.02141287284141,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 107.68807953950808,
   "end": 109.98635618349901,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 127.886356183499,
   "end": 129.69120879120877,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 130.09120879120877,
   "end": 132.40875981161693,
   "text": "That's the end. Thank you!"

 "speech": [
  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 12.96263038548753,
   "text": "Play with me."
  },
  {
   "who": "therapist",
   "start": 23.235357658214802,
   "end": 25.040210265924554,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 25.440210265924552,
   "end": 27.738486909915483,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 42.72939600082457,
   "end": 43.81093795093795,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 44.21093795093795,
   "end": 46.05365903937332,
   "text": "Now let's slow down."
  },
  {
   "who": "therapist",
   "start": 62.41729540300969,
   "end": 65.5319439290868,
   "text": "Let's play together. Ready, go."
  },
  {
   "who": "therapist",
   "start": 77.4410348381777,
   "end": 79.12693052978767,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 88.85420325706039,
   "end": 90.65905586477014,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 91.05905586477014,
   "end": 93.35733250876108,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 113.0118779633065,
   "end": 115.32942898371466,
   "text": "That's the end. Thank you!"
  }

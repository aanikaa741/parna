   "end": 13.449931972789118,
   "text": "Keep the beat with me."
  },
  {
   "who": "therapist",
   "start": 30.44993197278912,
   "end": 32.25478458049887,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 32.65478458049887,
   "end": 34.9530612244898,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 52.8530612244898,
   "end": 54.632653061224495,
   "text": "Now let's go faster."

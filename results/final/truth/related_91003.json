   "start": 86.46776207919062,
   "end": 87.37796616082328,
   "text": "Nice!"
  },
  {
   "who": "therapist",
   "start": 87.77796616082328,
   "end": 89.46386185243325,
   "text": "Can you sing ah with me?"
  },
  {

   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 13.449931972789118,
   "text": "Keep the beat with me."
  },
  {
   "who": "therapist",
   "start": 31.116598639455788,
   "end": 32.198140589569164,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 32.59814058956916,
   "end": 34.89641723356009,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 63.76308390022677,
   "end": 65.54267573696146,
   "text": "Now let's go faster."
  },
  {
   "who": "therapist",
   "start": 84.13882958311524,
   "end": 85.28771847200413,
   "text": "Play with me."
  },
  {
   "who": "therapist",
   "start": 101.28771847200413,
   "end": 102.3692604221175,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 102.76926042211751,
   "end": 104.45515611372748,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 118.78848944706081,
   "end": 121.08676609105174,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 149.95343275771842,
   "end": 152.27098377812658,
   "text": "That's the end. Thank you!"
  }

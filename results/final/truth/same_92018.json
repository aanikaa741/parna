   "start": 65.8105843362986,
   "end": 67.49648002790858,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 75.88109541252396,
   "end": 77.68594802023371,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 78.08594802023372,
   "end": 80.38422466422465,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 97.35345543345541,
   "end": 98.50642595499735,
   "text": "Great job."
  },
  {
   "who": "therapist",
   "start": 98.90642595499736,
   "end": 101.22397697540552,
   "text": "That's the end. Thank you!"
  }

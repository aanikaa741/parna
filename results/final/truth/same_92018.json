   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 14.928390022675739,
   "text": "Let's play together. Ready, go."
  },
  {
   "who": "therapist",
   "start": 25.159159253444972,
   "end": 27.457435897435904,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 40.43435897435898,
   "end": 42.277080062794354,
   "text": "Now let's slow down."
  },
  {
   "who": "therapist",
   "start": 56.27708006279433,
   "end": 57.425968951683224,
   "text": "Play with me."
  },
  {

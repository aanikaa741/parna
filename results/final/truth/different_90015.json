 "speech": [
  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 12.96263038548753,
   "text": "Play with me."
  },
  {
   "who": "therapist",
   "start": 24.57801500087215,
   "end": 26.87629164486308,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 39.85321472178615,
   "end": 41.69593581022153,
   "text": "Now let's slow down."
  },
  {
   "who": "therapist",
   "start": 55.695935810221506,
   "end": 57.332126286411984,
   "text": "Keep the beat with me."
  },
  {
   "who": "therapist",
   "start": 67.5628955171812,
   "end": 69.24879120879118,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 77.63340659340656,
   "end": 78.54361067503922,
   "text": "Nice!"
  },
  {
   "who": "therapist",
   "start": 78.94361067503922,
   "end": 81.24188731903016,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 98.21111808826092,
   "end": 100.01597069597067,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 100.41597069597067,
   "end": 102.73352171637883,
   "text": "That's the end. Thank you!"
  }

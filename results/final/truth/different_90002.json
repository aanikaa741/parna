  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 13.449931972789118,
   "text": "Keep the beat with me."
  },
  {
   "who": "therapist",
   "start": 28.44993197278912,
   "end": 29.60290249433107,
   "text": "Great job."
  },
  {
   "who": "therapist",
   "start": 30.002902494331067,
   "end": 32.301179138322,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 50.201179138322,
   "end": 51.98077097505669,
   "text": "Now let's go faster."
  },
  {
   "who": "therapist",
   "start": 67.05769405197975,
   "end": 68.13923600209313,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 68.53923600209313,
   "end": 71.65388452817024,
   "text": "Let's play together. Ready, go."
  },
  {
   "who": "therapist",
   "start": 84.65388452817024,
   "end": 86.33978021978021,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 98.00644688644688,
   "end": 99.08798883656026,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 99.48798883656026,
   "end": 101.7862654805512,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 125.31959881388451,
   "end": 127.63714983429267,
   "text": "That's the end. Thank you!"
  }

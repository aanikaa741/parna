   "end": 14.928390022675739,
   "text": "Let's play together. Ready, go."
  },
  {
   "who": "therapist",
   "start": 25.620697714983436,
   "end": 27.918974358974367,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 44.88820512820513,
   "end": 46.667796964939825,
   "text": "Now let's go faster."
  },
  {
   "who": "therapist",
   "start": 57.413359095117336,
   "end": 59.218211702827084,
   "text": "Let's try another one."

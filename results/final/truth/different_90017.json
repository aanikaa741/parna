   "start": 59.61821170282708,
   "end": 60.76710059171597,
   "text": "Play with me."
  },
  {
   "who": "therapist",
   "start": 69.61325443786981,
   "end": 70.69479638798319,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 71.0947963879832,
   "end": 72.78069207959317,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 81.16530746420855,

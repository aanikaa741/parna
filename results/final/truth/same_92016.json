   "start": 89.54811791383219,
   "end": 90.70108843537413,
   "text": "Great job."
  },
  {
   "who": "therapist",
   "start": 91.10108843537414,
   "end": 93.39936507936507,
   "text": "I play, then you copy me."
  },
  {

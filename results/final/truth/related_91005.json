   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 14.928390022675739,
   "text": "Let's play together. Ready, go."
  },
  {
   "who": "therapist",
   "start": 27.928390022675742,
   "end": 28.838594104308395,
   "text": "Nice!"
  },
  {
   "who": "therapist",
   "start": 29.238594104308394,
   "end": 31.536870748299325,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 49.43687074829932,
   "end": 51.279591836734696,
   "text": "Now let's slow down."
  },
  {
   "who": "therapist",
   "start": 71.05736961451244,
   "end": 72.20625850340133,
   "text": "Play with me."
  },
  {
   "who": "therapist",
   "start": 87.872925170068,
   "end": 89.55882086167797,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 101.22548752834464,
   "end": 103.03034013605439,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 103.4303401360544,
   "end": 105.72861678004533,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 129.26195011337865,
   "end": 131.5795011337868,
   "text": "That's the end. Thank you!"
  }

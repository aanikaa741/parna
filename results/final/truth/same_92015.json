 "speech": [
  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 12.96263038548753,
   "text": "Play with me."
  },
  {
   "who": "therapist",
   "start": 27.053539476396622,
   "end": 28.20650999793857,
   "text": "Great job."
  },
  {
   "who": "therapist",
   "start": 28.60650999793857,
   "end": 30.9047866419295,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 50.559332096474954,
   "end": 52.40205318491033,
   "text": "Now let's slow down."
  },
  {
   "who": "therapist",
   "start": 68.76568954854672,
   "end": 70.4018800247372,
   "text": "Keep the beat with me."
  },
  {
   "who": "therapist",
   "start": 82.85642547928265,
   "end": 84.54232117089262,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 94.26959389816534,
   "end": 95.35113584827872,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 95.75113584827872,
   "end": 98.04941249226965,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 117.70395794681508,
   "end": 118.61416202844774,
   "text": "Nice!"
  },
  {
   "who": "therapist",
   "start": 119.01416202844774,
   "end": 121.3317130488559,
   "text": "That's the end. Thank you!"
  }
 ],

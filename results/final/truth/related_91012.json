 "speech": [
  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 12.96263038548753,
   "text": "Play with me."
  },
  {
   "who": "therapist",
   "start": 27.962630385487532,
   "end": 29.767482993197284,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 30.167482993197282,
   "end": 32.465759637188214,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 50.36575963718821,
   "end": 51.518730158730165,
   "text": "Great job."
  },
  {
   "who": "therapist",
   "start": 51.91873015873016,
   "end": 53.76145124716554,
   "text": "Now let's slow down."
  },
  {
   "who": "therapist",
   "start": 73.53922902494327,
   "end": 74.62077097505664,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 75.02077097505665,
   "end": 76.16965986394554,
   "text": "Play with me."
  },
  {
   "who": "therapist",
   "start": 89.83632653061221,
   "end": 91.52222222222218,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 103.18888888888885,
   "end": 105.48716553287979,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 129.0204988662131,
   "end": 131.33804988662126,
   "text": "That's the end. Thank you!"
  }

 "speech": [
  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 14.928390022675739,
   "text": "Let's play together. Ready, go."
  },
  {
   "who": "therapist",
   "start": 25.746571840857555,
   "end": 26.65677592249021,
   "text": "Nice!"
  },
  {
   "who": "therapist",
   "start": 27.056775922490207,
   "end": 29.355052566481138,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 49.00959802102659,
   "end": 50.16256854256854,
   "text": "Great job."
  },
  {
   "who": "therapist",
   "start": 50.56256854256854,
   "end": 52.40528963100392,
   "text": "Now let's slow down."
  },
  {
   "who": "therapist",
   "start": 68.76892599464031,
   "end": 70.57377860235006,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 70.97377860235007,
   "end": 72.60996907854054,
   "text": "Keep the beat with me."
  },
  {
   "who": "therapist",
   "start": 82.33724180581328,
   "end": 84.02313749742325,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 93.75041022469597,
   "end": 94.83195217480935,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 95.23195217480935,
   "end": 97.53022881880028,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 117.18477427334571,
   "end": 118.09497835497837,
   "text": "Nice!"
  },
  {
   "who": "therapist",
   "start": 118.49497835497837,
   "end": 120.81252937538653,
   "text": "That's the end. Thank you!"
  }

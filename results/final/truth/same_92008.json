 "speech": [
  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 13.449931972789118,
   "text": "Keep the beat with me."
  },
  {
   "who": "therapist",
   "start": 23.177204700061846,
   "end": 25.475481344052778,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 40.466390434961866,
   "end": 41.61936095650382,
   "text": "Great job."
  },
  {
   "who": "therapist",
   "start": 42.01936095650382,
   "end": 43.86208204493919,
   "text": "Now let's slow down."
  },
  {
   "who": "therapist",
   "start": 60.22571840857556,
   "end": 61.86190888476604,
   "text": "Keep the beat with me."
  },
  {
   "who": "therapist",
   "start": 75.95281797567512,
   "end": 77.75767058338486,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 78.15767058338487,
   "end": 79.84356627499484,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 89.57083900226758,
   "end": 91.8691156462585,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 111.52366110080393,
   "end": 112.43386518243659,
   "text": "Nice!"
  },
  {
   "who": "therapist",
   "start": 112.8338651824366,
   "end": 115.15141620284476,
   "text": "That's the end. Thank you!"
  }

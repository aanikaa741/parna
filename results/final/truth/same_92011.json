   "start": 11.813741496598642,
   "end": 13.449931972789118,
   "text": "Keep the beat with me."
  },
  {
   "who": "therapist",
   "start": 22.296085818942966,
   "end": 23.449056340484915,
   "text": "Great job."
  },
  {
   "who": "therapist",
   "start": 23.849056340484914,
   "end": 26.147332984475845,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 39.12425606139892,
   "end": 40.90384789813361,
   "text": "Now let's go faster."
  },
  {

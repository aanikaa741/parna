   "start": 51.64941002831113,
   "end": 52.55961410994379,
   "text": "Nice!"
  },
  {
   "who": "therapist",
   "start": 52.959614109943786,
   "end": 54.10850299883268,
   "text": "Play with me."
  },
  {
   "who": "therapist",
   "start": 66.18542607575574,
   "end": 67.87132176736571,
   "text": "Can you sing ah with me?"

   "start": 76.2559371519811,
   "end": 78.55421379597203,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 95.5234445652028,
   "end": 96.43364864683545,
   "text": "Nice!"
  },
  {
   "who": "therapist",
   "start": 96.83364864683546,
   "end": 99.15119966724362,
   "text": "That's the end. Thank you!"

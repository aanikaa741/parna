 "speech": [
  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 12.96263038548753,
   "text": "Play with me."
  },
  {
   "who": "therapist",
   "start": 29.795963718820865,
   "end": 32.094240362811796,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 60.96090702947847,
   "end": 62.803628117913846,
   "text": "Now let's slow down."
  },
  {
   "who": "therapist",
   "start": 87.27585034013606,
   "end": 88.91204081632654,
   "text": "Keep the beat with me."
  },
  {
   "who": "therapist",
   "start": 107.41204081632654,
   "end": 109.21689342403629,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 109.61689342403629,
   "end": 111.30278911564626,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 125.63612244897959,
   "end": 127.93439909297052,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 149.83439909297053,
   "end": 152.1519501133787,
   "text": "That's the end. Thank you!"
  }

 "speech": [
  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 13.449931972789118,
   "text": "Keep the beat with me."
  },
  {
   "who": "therapist",
   "start": 29.44993197278912,
   "end": 30.60290249433107,
   "text": "Great job."
  },
  {
   "who": "therapist",
   "start": 31.002902494331067,
   "end": 33.301179138322,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 55.201179138322004,
   "end": 56.9807709750567,
   "text": "Now let's go faster."
  },
  {
   "who": "therapist",
   "start": 75.5769248212105,
   "end": 76.65846677132387,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 77.05846677132388,
   "end": 78.20735566021277,
   "text": "Play with me."
  },
  {
   "who": "therapist",
   "start": 94.20735566021277,
   "end": 95.89325135182274,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 110.22658468515607,
   "end": 112.03143729286582,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 112.43143729286582,
   "end": 114.72971393685675,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 136.62971393685675,
   "end": 137.5399180184894,
   "text": "Nice!"
  },
  {
   "who": "therapist",
   "start": 137.9399180184894,
   "end": 140.25746903889757,
   "text": "That's the end. Thank you!"
  }

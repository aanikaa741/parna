  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 12.96263038548753,
   "text": "Play with me."
  },
  {
   "who": "therapist",
   "start": 24.6292970521542,
   "end": 26.92757369614513,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 50.46090702947846,
   "end": 52.30362811791384,
   "text": "Now let's slow down."
  },
  {
   "who": "therapist",
   "start": 72.08140589569159,
   "end": 73.88625850340134,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 74.28625850340134,
   "end": 75.43514739229023,
   "text": "Play with me."
  },
  {
   "who": "therapist",
   "start": 90.43514739229023,
   "end": 91.58811791383218,
   "text": "Great job."
  },
  {
   "who": "therapist",
   "start": 91.98811791383218,
   "end": 93.67401360544216,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 105.34068027210883,
   "end": 107.63895691609976,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 131.17229024943308,
   "end": 132.25383219954645,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 132.65383219954646,
   "end": 134.97138321995462,
   "text": "That's the end. Thank you!"
  }

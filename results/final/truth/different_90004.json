 "speech": [
  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 12.96263038548753,
   "text": "Play with me."
  },
  {
   "who": "therapist",
   "start": 24.871721294578442,
   "end": 26.02469181612039,
   "text": "Great job."
  },
  {
   "who": "therapist",
   "start": 26.42469181612039,
   "end": 28.72296846011132,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 43.71387755102041,
   "end": 45.556598639455785,
   "text": "Now let's slow down."
  },
  {
   "who": "therapist",
   "start": 61.920235003092145,
   "end": 65.03488352916924,
   "text": "Let's play together. Ready, go."
  },
  {
   "who": "therapist",
   "start": 76.3985198928056,
   "end": 78.08441558441557,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 87.8116883116883,
   "end": 88.72189239332096,
   "text": "Nice!"
  },
  {
   "who": "therapist",
   "start": 89.12189239332096,
   "end": 91.4201690373119,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 106.41107812822096,
   "end": 108.21593073593071,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 108.61593073593072,
   "end": 110.93348175633888,
   "text": "That's the end. Thank you!"
  }

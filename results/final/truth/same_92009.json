   "text": "Nice!"
  },
  {
   "who": "therapist",
   "start": 104.37045351473925,
   "end": 106.05634920634922,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 120.38968253968255,
   "end": 122.68795918367348,
   "text": "I play, then you copy me."
  },

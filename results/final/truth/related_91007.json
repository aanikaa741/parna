 "speech": [
  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 13.449931972789118,
   "text": "Keep the beat with me."
  },
  {
   "who": "therapist",
   "start": 25.065316588173737,
   "end": 27.363593232164668,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 44.33282400139543,
   "end": 46.13767660910518,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 46.537676609105176,
   "end": 48.38039769754055,
   "text": "Now let's slow down."

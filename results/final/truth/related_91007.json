   "who": "therapist",
   "start": 62.38039769754053,
   "end": 64.01658817373101,
   "text": "Keep the beat with me."
  },
  {
   "who": "therapist",
   "start": 75.63197278911562,
   "end": 76.713514739229,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 77.113514739229,
   "end": 78.79941043083898,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 87.18402581545436,
   "end": 88.09422989708702,
   "text": "Nice!"
  },
  {
   "who": "therapist",
   "start": 88.49422989708702,
   "end": 90.79250654107796,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 107.76173731030872,
   "end": 109.56658991801847,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 109.96658991801847,
   "end": 112.28414093842663,
   "text": "That's the end. Thank you!"

 "speech": [
  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 12.96263038548753,
   "text": "Play with me."
  },
  {
   "who": "therapist",
   "start": 27.962630385487532,
   "end": 30.260907029478464,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 48.16090702947846,
   "end": 49.31387755102041,
   "text": "Great job."
  },
  {
   "who": "therapist",
   "start": 49.71387755102041,
   "end": 51.556598639455785,
   "text": "Now let's slow down."
  },
  {
   "who": "therapist",
   "start": 71.33437641723353,
   "end": 74.44902494331063,
   "text": "Let's play together. Ready, go."
  },
  {
   "who": "therapist",
   "start": 88.78235827664396,
   "end": 89.69256235827662,
   "text": "Nice!"
  },
  {
   "who": "therapist",
   "start": 90.09256235827662,
   "end": 91.7784580498866,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 103.44512471655327,
   "end": 105.7434013605442,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 123.64340136054417,
   "end": 125.96095238095234,
   "text": "That's the end. Thank you!"
  }

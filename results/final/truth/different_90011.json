   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 14.928390022675739,
   "text": "Let's play together. Ready, go."
  },
  {
   "who": "therapist",
   "start": 25.746571840857555,
   "end": 28.044848484848487,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 47.69939393939394,
   "end": 49.54211502782932,
   "text": "Now let's slow down."
  },
  {
   "who": "therapist",
   "start": 65.90575139146569,
   "end": 67.05464028035458,
   "text": "Play with me."
  },
  {
   "who": "therapist",
   "start": 81.14554937126367,
   "end": 82.22709132137705,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 82.62709132137705,
   "end": 84.31298701298702,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 94.04025974025976,
   "end": 94.95046382189241,
   "text": "Nice!"
  },
  {
   "who": "therapist",
   "start": 95.35046382189242,
   "end": 97.64874046588335,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 112.63964955679242,
   "end": 114.95720057720058,
   "text": "That's the end. Thank you!"
  }

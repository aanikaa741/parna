 "speech": [
  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 12.96263038548753,
   "text": "Play with me."
  },
  {
   "who": "therapist",
   "start": 25.962630385487532,
   "end": 27.044172335600912,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 27.44417233560091,
   "end": 29.742448979591842,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 53.27578231292517,
   "end": 54.35732426303855,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 54.75732426303855,
   "end": 56.60004535147392,
   "text": "Now let's slow down."
  },
  {
   "who": "therapist",
   "start": 76.37782312925164,
   "end": 79.49247165532873,
   "text": "Let's play together. Ready, go."
  },
  {
   "who": "therapist",
   "start": 95.1591383219954,
   "end": 96.84503401360537,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 108.51170068027204,
   "end": 110.80997732426297,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 134.34331065759628,
   "end": 136.14816326530604,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 136.54816326530604,
   "end": 138.8657142857142,
   "text": "That's the end. Thank you!"
  }
 ],

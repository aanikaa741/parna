 "speech": [
  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 12.96263038548753,
   "text": "Play with me."
  },
  {
   "who": "therapist",
   "start": 32.295963718820865,
   "end": 34.10081632653061,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 34.50081632653061,
   "end": 36.79909297052154,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 65.6657596371882,
   "end": 67.4453514739229,
   "text": "Now let's go faster."
  },
  {
   "who": "therapist",
   "start": 86.04150532007668,
   "end": 89.15615384615379,
   "text": "Let's play together. Ready, go."
  },
  {
   "who": "therapist",
   "start": 107.65615384615379,
   "end": 109.34204953776376,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 123.67538287109709,
   "end": 124.58558695272974,
   "text": "Nice!"
  },
  {
   "who": "therapist",
   "start": 124.98558695272975,
   "end": 127.28386359672068,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 149.18386359672067,
   "end": 150.26540554683405,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 150.66540554683405,
   "end": 152.9829565672422,
   "text": "That's the end. Thank you!"
  }

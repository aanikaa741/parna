 "speech": [
  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 13.449931972789118,
   "text": "Keep the beat with me."
  },
  {
   "who": "therapist",
   "start": 24.142239665096813,
   "end": 25.295210186638762,
   "text": "Great job."
  },
  {
   "who": "therapist",
   "start": 25.69521018663876,
   "end": 27.993486830629692,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 40.970409907552764,
   "end": 42.75000174428746,
   "text": "Now let's go faster."
  },
  {
   "who": "therapist",
   "start": 53.49556387446497,
   "end": 55.30041648217472,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 55.70041648217472,
   "end": 56.84930537106361,
   "text": "Play with me."
  },
  {
   "who": "therapist",
   "start": 67.5416130633713,
   "end": 69.22750875498127,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 77.61212413959666,
   "end": 78.7650946611386,
   "text": "Great job."
  },
  {
   "who": "therapist",
   "start": 79.16509466113861,
   "end": 81.46337130512954,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 94.44029438205261,
   "end": 96.75784540246077,
   "text": "That's the end. Thank you!"
  }

 "speech": [
  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 12.96263038548753,
   "text": "Play with me."
  },
  {
   "who": "therapist",
   "start": 22.270322693179843,
   "end": 24.568599337170774,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 41.537830106401536,
   "end": 42.61937205651491,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 43.01937205651491,
   "end": 44.798963893249606,
   "text": "Now let's go faster."
  },
  {
   "who": "therapist",
   "start": 55.54452602342712,
   "end": 56.69749654496907,
   "text": "Great job."
  },
  {
   "who": "therapist",
   "start": 57.09749654496907,
   "end": 58.73368702115955,
   "text": "Keep the beat with me."
  },
  {
   "who": "therapist",
   "start": 68.96445625192877,
   "end": 70.04599820204214,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 70.44599820204215,
   "end": 72.13189389365212,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 80.5165092782675,
   "end": 81.66947979980945,
   "text": "Great job."
  },
  {
   "who": "therapist",
   "start": 82.06947979980946,
   "end": 84.36775644380039,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 101.33698721303115,
   "end": 102.2471912946638,
   "text": "Nice!"
  },
  {
   "who": "therapist",
   "start": 102.64719129466381,
   "end": 104.96474231507197,
   "text": "That's the end. Thank you!"
  }

 "speech": [
  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 13.449931972789118,
   "text": "Keep the beat with me."
  },
  {
   "who": "therapist",
   "start": 25.904477427334573,
   "end": 27.709330035044324,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 28.109330035044323,
   "end": 30.407606679035254,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 45.398515769944346,
   "end": 46.308719851577,
   "text": "Nice!"
  },
  {
   "who": "therapist",
   "start": 46.708719851577,
   "end": 48.4883116883117,
   "text": "Now let's go faster."
  },
  {
   "who": "therapist",
   "start": 61.00579420579423,
   "end": 64.12044273187132,
   "text": "Let's play together. Ready, go."
  },
  {
   "who": "therapist",
   "start": 75.48407909550768,
   "end": 77.28893170321743,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 77.68893170321743,
   "end": 79.3748273948274,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 89.10210012210013,
   "end": 91.40037676609106,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 111.05492222063648,
   "end": 113.37247324104464,
   "text": "That's the end. Thank you!"
  }

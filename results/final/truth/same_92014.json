 "speech": [
  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 14.928390022675739,
   "text": "Let's play together. Ready, go."
  },
  {
   "who": "therapist",
   "start": 26.543774638060356,
   "end": 28.348627245770107,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 28.748627245770106,
   "end": 31.046903889761037,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 48.0161346589918,
   "end": 49.09767660910518,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 49.49767660910518,
   "end": 51.27726844583987,
   "text": "Now let's go faster."
  },
  {
   "who": "therapist",
   "start": 62.02283057601739,
   "end": 63.82768318372714,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 64.22768318372714,
   "end": 65.37657207261603,
   "text": "Play with me."
  },
  {
   "who": "therapist",
   "start": 76.06887976492372,
   "end": 77.1504217150371,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 77.5504217150371,
   "end": 79.23631740664707,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 87.62093279126246,
   "end": 89.91920943525339,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 106.88844020448416,
   "end": 109.20599122489232,
   "text": "That's the end. Thank you!"
  }

   "start": 96.22582766439908,
   "end": 97.37471655328797,
   "text": "Play with me."
  },
  {
   "who": "therapist",
   "start": 111.7080498866213,
   "end": 112.78959183673467,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 113.18959183673468,
   "end": 114.87548752834465,
   "text": "Can you sing ah with me?"
  },

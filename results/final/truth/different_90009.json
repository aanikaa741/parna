 "speech": [
  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 14.928390022675739,
   "text": "Let's play together. Ready, go."
  },
  {
   "who": "therapist",
   "start": 27.26172335600907,
   "end": 28.34326530612245,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 28.74326530612245,
   "end": 31.04154195011338,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 48.94154195011338,
   "end": 50.74639455782313,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 51.14639455782313,
   "end": 52.989115646258504,
   "text": "Now let's slow down."
  },
  {
   "who": "therapist",
   "start": 72.76689342403624,
   "end": 73.84843537414962,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 74.24843537414962,
   "end": 75.8846258503401,
   "text": "Keep the beat with me."
  },
  {
   "who": "therapist",
   "start": 87.55129251700677,
   "end": 89.23718820861674,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 100.90385487528341,
   "end": 102.70870748299316,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 103.10870748299317,
   "end": 105.4069841269841,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 128.9403174603174,
   "end": 131.25786848072556,
   "text": "That's the end. Thank you!"
  }

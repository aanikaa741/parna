 "speech": [
  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 12.96263038548753,
   "text": "Play with me."
  },
  {
   "who": "therapist",
   "start": 29.295963718820865,
   "end": 30.377505668934244,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 30.777505668934243,
   "end": 33.07578231292517,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 56.6091156462585,
   "end": 58.45183673469388,
   "text": "Now let's slow down."
  },
  {
   "who": "therapist",
   "start": 78.22961451247158,
   "end": 79.31115646258496,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 79.71115646258497,
   "end": 81.34734693877544,
   "text": "Keep the beat with me."
  },
  {
   "who": "therapist",
   "start": 97.68068027210877,
   "end": 98.76222222222215,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 99.16222222222216,
   "end": 100.84811791383213,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 112.5147845804988,
   "end": 114.81306122448973,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 132.7130612244897,
   "end": 135.03061224489787,
   "text": "That's the end. Thank you!"
  }

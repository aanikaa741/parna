   "start": 23.77454386882959,
   "end": 26.07282051282052,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 43.04205128205128,
   "end": 44.82164311878598,
   "text": "Now let's go faster."
  },
  {
   "who": "therapist",
   "start": 55.567205248963496,
   "end": 57.203395725153975,
   "text": "Keep the beat with me."
  },
  {
   "who": "therapist",
   "start": 67.4341649559232,
   "end": 69.12006064753317,
   "text": "Can you sing ah with me?"

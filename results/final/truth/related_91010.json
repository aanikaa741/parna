 "speech": [
  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 13.449931972789118,
   "text": "Keep the beat with me."
  },
  {
   "who": "therapist",
   "start": 27.116598639455788,
   "end": 28.92145124716554,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 29.321451247165538,
   "end": 31.61972789115647,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 49.51972789115647,
   "end": 51.362448979591846,
   "text": "Now let's slow down."
  },
  {
   "who": "therapist",
   "start": 71.14022675736959,
   "end": 72.94507936507934,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 73.34507936507934,
   "end": 76.45972789115643,
   "text": "Let's play together. Ready, go."
  },
  {
   "who": "therapist",
   "start": 92.1263945578231,
   "end": 93.81229024943308,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 105.47895691609975,
   "end": 107.77723356009068,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 125.67723356009066,
   "end": 126.8302040816326,
   "text": "Great job."
  },
  {
   "who": "therapist",
   "start": 127.2302040816326,
   "end": 129.54775510204078,
   "text": "That's the end. Thank you!"
  }
 ],

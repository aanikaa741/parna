 "speech": [
  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 13.449931972789118,
   "text": "Keep the beat with me."
  },
  {
   "who": "therapist",
   "start": 27.54084106369821,
   "end": 29.83911770768914,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 49.4936631622346,
   "end": 51.33638425066997,
   "text": "Now let's slow down."
  },
  {
   "who": "therapist",
   "start": 67.70002061430635,
   "end": 69.5048732220161,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 69.9048732220161,
   "end": 73.01952174809321,
   "text": "Let's play together. Ready, go."
  },
  {
   "who": "therapist",
   "start": 87.1104308390023,
   "end": 88.02063492063496,
   "text": "Nice!"
  },
  {
   "who": "therapist",
   "start": 88.42063492063497,
   "end": 90.10653061224494,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 99.83380333951766,
   "end": 102.13207998350859,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 121.78662543805402,
   "end": 122.8681673881674,
   "text": "Well done."
  },
  {
   "who": "therapist",
   "start": 123.2681673881674,
   "end": 125.58571840857556,
   "text": "That's the end. Thank you!"
  }
 ],

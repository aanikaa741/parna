 "speech": [
  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 13.449931972789118,
   "text": "Keep the beat with me."
  },
  {
   "who": "therapist",
   "start": 24.142239665096813,
   "end": 25.052443746729466,
   "text": "Nice!"
  },
  {
   "who": "therapist",
   "start": 25.452443746729465,
   "end": 27.750720390720396,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 44.71995115995116,
   "end": 46.562672248386534,
   "text": "Now let's slow down."
  },
  {
   "who": "therapist",
   "start": 60.56267224838651,
   "end": 61.7115611372754,
   "text": "Play with me."
  },
  {
   "who": "therapist",
   "start": 73.78848421419848,
   "end": 75.59333682190822,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 75.99333682190823,
   "end": 77.6792325135182,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 86.06384789813359,
   "end": 88.36212454212452,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 105.33135531135528,
   "end": 107.64890633176344,
   "text": "That's the end. Thank you!"
  }
 ],

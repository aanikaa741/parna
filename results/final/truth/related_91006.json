 "speech": [
  {
   "who": "therapist",
   "start": 0.8,
   "end": 4.31374149659864,
   "text": "First, tap your drum five times on your own."
  },
  {
   "who": "therapist",
   "start": 11.813741496598642,
   "end": 14.928390022675739,
   "text": "Let's play together. Ready, go."
  },
  {
   "who": "therapist",
   "start": 26.543774638060356,
   "end": 28.842051282051287,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 45.81128205128205,
   "end": 47.590873888016745,
   "text": "Now let's go faster."
  },
  {
   "who": "therapist",
   "start": 58.336436018194256,
   "end": 59.972626494384734,
   "text": "Keep the beat with me."
  },
  {
   "who": "therapist",
   "start": 70.20339572515395,
   "end": 71.3563662466959,
   "text": "Great job."
  },
  {
   "who": "therapist",
   "start": 71.7563662466959,
   "end": 73.44226193830588,
   "text": "Can you sing ah with me?"
  },
  {
   "who": "therapist",
   "start": 81.82687732292126,
   "end": 83.63172993063101,
   "text": "Let's try another one."
  },
  {
   "who": "therapist",
   "start": 84.03172993063102,
   "end": 86.33000657462195,
   "text": "I play, then you copy me."
  },
  {
   "who": "therapist",
   "start": 99.30692965154502,
   "end": 100.21713373317768,
   "text": "Nice!"
  },
  {
   "who": "therapist",
   "start": 100.61713373317768,
   "end": 102.93468475358584,
   "text": "That's the end. Thank you!"
  }
 ],
